{
  "name": "NotificacaoManutencao",
  "type": "object",
  "properties": {
    "chamado_id": {
      "type": "string",
      "description": "ID do chamado relacionado"
    },
    "numero_chamado": {
      "type": "string",
      "description": "N\u00famero do chamado"
    },
    "cm": {
      "type": "string",
      "description": "C\u00f3digo do CM"
    },
    "placa": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "empresa_executora": {
      "type": "string",
      "description": "Empresa executora"
    },
    "tecnico_responsavel": {
      "type": "string",
      "description": "T\u00e9cnico respons\u00e1vel"
    },
    "status_anterior": {
      "type": "string",
      "description": "Status anterior"
    },
    "status_novo": {
      "type": "string",
      "description": "Novo status"
    },
    "data_notificacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da notifica\u00e7\u00e3o"
    },
    "visualizada": {
      "type": "boolean",
      "default": false,
      "description": "Se a notifica\u00e7\u00e3o foi visualizada"
    },
    "data_visualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que foi visualizada"
    }
  },
  "required": [
    "chamado_id",
    "placa",
    "status_novo"
  ]
}