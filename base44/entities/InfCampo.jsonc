{
  "name": "InfCampo",
  "type": "object",
  "properties": {
    "modulo_numero": {
      "type": "number",
      "description": "N\u00famero do m\u00f3dulo (1-14)"
    },
    "fazenda": {
      "type": "string",
      "description": "Nome da fazenda"
    },
    "projeto": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "data_turno": {
      "type": "string",
      "format": "date",
      "description": "Data do turno"
    },
    "turno": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "description": "Turno (1=06-14, 2=14-22, 3=22-06)"
    },
    "supervisor": {
      "type": "string",
      "description": "Supervisor respons\u00e1vel"
    },
    "assistente_campo": {
      "type": "string",
      "description": "Assistente de campo"
    },
    "meta_entrega_m3": {
      "type": "number",
      "description": "Meta de entrega em m\u00b3"
    },
    "dmt": {
      "type": "number",
      "description": "Dist\u00e2ncia M\u00e9dia de Transporte"
    },
    "nota_fazenda": {
      "type": "number",
      "description": "Nota da fazenda"
    },
    "peso_medio": {
      "type": "number",
      "description": "Peso m\u00e9dio entregue"
    },
    "media_m3_viagem": {
      "type": "number",
      "description": "M\u00e9dia de m\u00b3 por viagem"
    },
    "cms_enviados": {
      "type": "number",
      "description": "Quantidade de CMs enviados"
    },
    "cms_carregando": {
      "type": "number",
      "description": "Quantidade de CMs carregando"
    },
    "cms_aguardando": {
      "type": "number",
      "description": "Quantidade de CMs aguardando"
    },
    "producao_atual_m3": {
      "type": "number",
      "description": "Produ\u00e7\u00e3o realizada at\u00e9 o momento (m\u00b3)"
    },
    "horas_trabalhadas": {
      "type": "number",
      "description": "Horas trabalhadas at\u00e9 o momento"
    },
    "impactos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de impactos operacionais"
    },
    "impacto_outro_detalhe": {
      "type": "string",
      "description": "Detalhamento do impacto 'Outro'"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es operacionais"
    },
    "historico_obs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Hist\u00f3rico de observa\u00e7\u00f5es registradas"
    },
    "equipamentos": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Lista de equipamentos do m\u00f3dulo"
    },
    "ultima_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio da \u00faltima atualiza\u00e7\u00e3o"
    },
    "status_operacional": {
      "type": "string",
      "description": "Status operacional calculado"
    }
  },
  "required": [
    "modulo_numero"
  ]
}