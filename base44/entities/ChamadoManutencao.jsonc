{
  "name": "ChamadoManutencao",
  "type": "object",
  "properties": {
    "numero_chamado": {
      "type": "string",
      "description": "N\u00famero do chamado (CH-XXXX)"
    },
    "cm": {
      "type": "string",
      "description": "C\u00f3digo do CM"
    },
    "placa": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "empresa_executora": {
      "type": "string",
      "description": "Empresa executora da manuten\u00e7\u00e3o"
    },
    "tecnico_responsavel": {
      "type": "string",
      "description": "T\u00e9cnico respons\u00e1vel"
    },
    "tipo_manutencao": {
      "type": "string",
      "enum": [
        "corretiva",
        "preventiva",
        "teste",
        "instalacao",
        "desinstalacao"
      ],
      "description": "Tipo de manuten\u00e7\u00e3o"
    },
    "descricao_problema": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o / Observa\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando",
        "em_manutencao",
        "aguardando_chamado",
        "desistencia",
        "liberado"
      ],
      "default": "aguardando",
      "description": "Status atual do chamado"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Prioridade do chamado"
    },
    "data_abertura": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de abertura"
    },
    "data_inicio_atendimento": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de in\u00edcio do atendimento"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de conclus\u00e3o"
    },
    "sla_horas": {
      "type": "number",
      "description": "SLA em horas"
    },
    "sla_estourado": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o SLA foi estourado"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    },
    "pecas_utilizadas": {
      "type": "string",
      "description": "Pe\u00e7as utilizadas na manuten\u00e7\u00e3o"
    },
    "fat_url": {
      "type": "string",
      "description": "URL do arquivo FAT enviado"
    },
    "fat_nome": {
      "type": "string",
      "description": "Nome do arquivo FAT"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se a notifica\u00e7\u00e3o foi enviada \u00e0 Central"
    },
    "aberto_por": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que abriu o chamado"
    },
    "modulo": {
      "type": "string",
      "description": "M\u00f3dulo ao qual o ve\u00edculo pertence"
    }
  },
  "required": [
    "cm",
    "status"
  ]
}